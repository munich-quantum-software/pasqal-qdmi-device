          "custom1": "EMU_FRESNEL"
        }
      },
      {
        "id": "pasqal.emu-mps",
        "library": "@PASQAL_QDMI_LIBRARY_FILE@",
        "prefix": "PASQAL",
        "enabled": true,
        "session": {
          "custom1": "EMU_MPS"
        }
      },
      {
        "id": "pasqal.emu-sv",
        "library": "@PASQAL_QDMI_LIBRARY_FILE@",
        "prefix": "PASQAL",
        "enabled": true,
