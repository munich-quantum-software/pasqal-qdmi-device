{
  "schema-version": 1,
  "qdmi": {
    "devices": [
      {
        "id": "@PASQAL_QDMI_DEVICE_ID@",
        "library": "@PASQAL_QDMI_LIBRARY_FILE@",
        "prefix": "PASQAL",
        "enabled": true,
        "session": {
          "custom1": "EMU_FREE"
        }
      },
      {
        "id": "pasqal.emu-free",
        "library": "@PASQAL_QDMI_LIBRARY_FILE@",
        "prefix": "PASQAL",
        "enabled": true,
        "session": {
          "custom1": "EMU_FREE"
        }
      }
    ]
  }
}
